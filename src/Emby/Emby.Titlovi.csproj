<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Emby.Titlovi</RootNamespace>
    <AssemblyName>Emby.Titlovi</AssemblyName>
    <Version>2.0.0.0</Version>
    <Nullable>disable</Nullable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <EmbyReferenceDir Condition="'$(EmbyReferenceDir)' == ''">$(MSBuildThisFileDirectory)../../.build/Emby/refs</EmbyReferenceDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Common/*.cs" Link="Common/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MediaBrowser.Model">
      <HintPath>$(EmbyReferenceDir)/MediaBrowser.Model.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="MediaBrowser.Common">
      <HintPath>$(EmbyReferenceDir)/MediaBrowser.Common.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="MediaBrowser.Controller">
      <HintPath>$(EmbyReferenceDir)/MediaBrowser.Controller.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration/configPage.html" />
    <None Remove="Configuration/configPage.js" />
    <EmbeddedResource Include="Configuration/configPage.html" />
    <EmbeddedResource Include="Configuration/configPage.js" />
    <EmbeddedResource Include="thumb.png" />
  </ItemGroup>
</Project>
